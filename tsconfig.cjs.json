{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "outDir": "cjs",
    "paths": {
      "@*": ["./src/*"],
      "shiki/core": ["./node_modules/shiki/dist/core.d.mts"],
      "shiki/engine/javascript": [
        "./node_modules/shiki/dist/engine-javascript.d.mts"
      ],
      "shiki/langs/*": ["./node_modules/shiki/dist/langs/*"],
      "shiki/themes/*": ["./node_modules/shiki/dist/themes/*"],
      "@shikijs/markdown-it/core": [
        "./node_modules/@shikijs/markdown-it/dist/core.d.mts"
      ]
    }
  }
}
