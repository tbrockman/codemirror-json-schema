{
  "name": "codemirror-json-schema",
  "license": "MIT",
  "version": "0.8.1",
  "description": "A fork of https://github.com/jsonnext/codemirror-json-schema - Codemirror 6 extensions that provide full JSONSchema support for `@codemirror/lang-json`, `codemirror-json5` and `@codemirror/lang-yaml`",
  "author": {
    "name": "Theodore Brockman",
    "url": "https://theo.lol"
  },
  "contributors": [
    {
      "name": "Samuel Imolorhe",
      "url": "https://xkoji.dev/"
    },
    {
      "name": "Rikki Schulte",
      "url": "https://rikki.dev"
    }
  ],
  "keywords": [
    "codemirror",
    "codemirror6",
    "jsonschema",
    "jsonschema-validation",
    "json5",
    "json",
    "editor"
  ],
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "main": "cjs/index.js",
  "files": [
    "dist",
    "cjs",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./cjs/index.js",
      "default": "./cjs/index.js"
    },
    "./json5": {
      "import": "./dist/json5/index.js",
      "types": "./dist/json5/index.d.ts",
      "require": "./cjs/json5/index.js",
      "default": "./cjs/json5/index.js"
    },
    "./yaml": {
      "import": "./dist/yaml/index.js",
      "types": "./dist/yaml/index.d.ts",
      "require": "./cjs/yaml/index.js",
      "default": "./cjs/yaml/index.js"
    }
  },
  "repository": "github:tbrockman/codemirror-json-schema",
  "homepage": "https://codemirror-json-schema.netlify.app/",
  "dependencies": {
    "@shikijs/markdown-it": "^4.5.0",
    "@types/json-schema": "^7.0.15",
    "best-effort-json-parser": "^1.5.1",
    "json-schema-library": "^9.3.5",
    "loglevel": "^1.9.2",
    "markdown-it": "^15.0.2",
    "shiki": "^4.5.0",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "codemirror-json5": "^1.0.3",
    "json5": "^2.2.3"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.10.2",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.27.0",
    "@lezer/common": "^1.2.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@evilmartians/lefthook": "^2.2.2",
    "@lezer/common": "^1.5.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "codemirror-json5": "^1.0.3",
    "happy-dom": "^21.0.1",
    "json5": "^2.2.3",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.4",
    "vitest-dom": "^0.1.1"
  },
  "scripts": {
    "dev": "vite ./dev --port 3000",
    "build": "pnpm tsc && pnpm build:cjs && vite build ./dev --outDir ../public --emptyOutDir",
    "build:cjs": "tsc -p tsconfig.cjs.json && sh scripts/cjs-package.sh",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc && pnpm replace:env",
    "version-packages": "changeset version && pnpm typedoc && pnpm prettier:write CHANGELOG.md && git add package.json pnpm-lock.yaml CHANGELOG.md",
    "release": "pnpm build && changeset publish",
    "typedoc": "typedoc && pnpm prettier:write docs/**/*",
    "prettier:write": "prettier --ignore-path .gitignore --write",
    "replace:env": "sh scripts/replace-env.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@evilmartians/lefthook",
      "esbuild"
    ]
  }
}
